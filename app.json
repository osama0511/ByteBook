{
  "expo": {
    "name": "ByteBook",
    "slug": "bytebook",
    "version": "1.0.0",
    "description": "16-Bit AI Interactive Verbatim Reader with Progressive Chapter Engine & Contextual AI Translation",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bytebook",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bytebook.reader",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.bytebook.reader",
      "adaptiveIcon": {
        "backgroundColor": "#0D130F",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "ByteBook — 16-Bit AI Interactive Reader",
      "shortName": "ByteBook",
      "display": "standalone",
      "startUrl": "/",
      "lang": "ar",
      "dir": "rtl",
      "backgroundColor": "#0D130F",
      "themeColor": "#0D130F"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D130F",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#0D130F"
  }
}
